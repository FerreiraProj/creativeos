# --- Database ---
DATABASE_URL="postgres://user:password@localhost:5432/creative_os"
DATABASE_SSL="false"

# --- AI ---
# Server-side fallback Gemini key, used when a request doesn't supply its own BYOK key
# (via the AI Gateway settings panel in the app).
GEMINI_API_KEY="your-gemini-api-key"

# Server-side fallback Fal.ai key (character portrait generation + per-shot talking video
# generation), used when a request doesn't supply its own BYOK key.
FAL_API_KEY="your-fal-api-key"

# --- Auth (single user, no roles) ---
# Preferred: a bcrypt hash of your login password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
APP_PASSWORD_HASH=""
# Dev-only plaintext fallback if no hash is set above:
# APP_PASSWORD="changeme"
SESSION_SECRET="replace-with-a-long-random-string"

# --- Server ---
PORT="3000"
# NODE_ENV is intentionally NOT set here — it must come from the real runtime (a shell
# export, Docker's `ENV NODE_ENV=production`, etc.), never from this file. Setting it here
# would also leak into the unrelated `vite build` process and silently bloat the production
# client bundle (see server/env.ts for why).
